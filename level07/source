#include <signal.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <unistd.h>

static void clear_stdin(void) {
    int character;

    do {
        character = getchar();
    } while (character != '\n' && character != EOF);
}

static unsigned int get_unum(void) {
    unsigned int value;

    value = 0;
    fflush(stdout);
    scanf("%u", &value);
    clear_stdin();
    return value;
}

void prog_timeout(int signal_number) {
    (void)signal_number;
    _exit(1);
}

static int store_number(unsigned int *storage) {
    unsigned int number;
    unsigned int index;

    printf(" Number: ");
    number = get_unum();
    printf(" Index: ");
    index = get_unum();
    printf(" Storing number at index %u\n", index);
    if ((index % 3U == 0U) || ((number >> 24) == 0xB7U)) {
        puts(" *** ERROR! ***");
        puts("   This index is reserved for wil!");
        puts(" *** ERROR! ***");
        return 1;
    }

    storage[index] = number;
    return 0;
}

static int read_number(unsigned int *storage) {
    unsigned int index;

    printf(" Index: ");
    index = get_unum();

    printf(" Number at data[%u] is %u\n", index, storage[index]);
    return 0;
}

int main(int argc, char **argv, char **envp) {
    unsigned int data[100];
    int status;
    char command[20];

    (void)argc;
    status = 0;
    memset(command, 0, sizeof(command));
    memset(data, 0, sizeof(data));

    while (*argv != NULL) {
        memset(*argv, 0, strlen(*argv));
        argv++;
    }

    while (*envp != NULL) {
        memset(*envp, 0, strlen(*envp));
        envp++;
    }

    puts("----------------------------------------------------");
    printf("  Welcome to wil's crappy number storage service!\n"
           "----------------------------------------------------\n"
           " Commands:\n"
           "    store - store a number into the data storage\n"
           "    read  - read a number from the data storage\n"
           "    quit  - exit the program\n"
           "----------------------------------------------------\n"
           "   wil has reserved some storage :>\n");

    while (1) {
        status = 1;
        printf("Input command: ");

        if (fgets(command, sizeof(command), stdin) == NULL) {
            break;
        }

        command[strlen(command) - 1] = '\0';

        if (strncmp(command, "store", 5) == 0) {
            status = store_number(data);
        } else if (strncmp(command, "read", 4) == 0) {
            status = read_number(data);
        } else if (strncmp(command, "quit", 4) == 0) {
            break;
        }

        if (status != 0) {
            printf(" Failed to do %s command\n", command);
        } else {
            printf(" Completed %s command successfully\n", command);
        }

        memset(command, 0, sizeof(command));
    }

    return 0;
}
