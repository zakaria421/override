#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

static void clear_stdin(void) {
    int c;

    do {
        c = getchar();
    } while (c != '\n' && c != EOF);
}

static unsigned int get_unum(void) {
    unsigned int value;

    value = 0;
    fflush(stdout);
    scanf("%u", &value);
    clear_stdin();
    return value;
}

static void decrypt(int key) {
    printf("inside decrypt: %d\n", key);
    char buffer[] = "Q}|u`sfg~sf{}|a3";
    const char *target = "Congratulations!";
    size_t index;

    for (index = 0; index < strlen(buffer); index++) {
        buffer[index] ^= (char)key;
    }

    if (strncmp(buffer, target, 17) == 0) {
        system("/bin/sh");
    } else {
        puts("Invalid Password");
    }
}

static void test(int user_value, int reference) {
    int diff;

    diff = reference - user_value;
    printf("Difference: %d\n", diff);
    if ((unsigned int)diff <= 0x15U) { //21 unsigned
        decrypt(diff);
    } else {
        decrypt(rand());
    }
}

int main(void) {
    int user_input;

    srand((unsigned int)time(NULL));

    puts("***********************************");
    puts("*\t\tlevel03\t\t**");
    puts("***********************************");
    printf("Password:");

    scanf("%d", &user_input);
    test(user_input, 0x1337d00d); // 322424845

    return 0;
}