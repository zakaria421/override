#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <sys/ptrace.h>
#include <sys/prctl.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <unistd.h>

extern char *gets(char *);

static void clear_stdin(void) {
    int character;

    do {
        character = getchar();
    } while (character != '\n' && character != EOF);
}

static unsigned int get_unum(void) {
    unsigned int value;

    value = 0;
    fflush(stdout);
    scanf("%u", &value);
    clear_stdin();
    return value;
}

static void prog_timeout(int signal_number) {
    (void)signal_number;
    _exit(1);
}

static void enable_timeout_cons(void) {
    signal(SIGALRM, prog_timeout);
    alarm(60);
}

int main(void) {
    pid_t child_pid;
    int wait_status;
    long traced_syscall;
    char input_buffer[128];

    child_pid = fork();
    traced_syscall = 0;
    wait_status = 0;

    for (unsigned int index = 0; index < 128; index++) {
        input_buffer[index] = '\0';
    }

    if (child_pid == 0) {
        prctl(PR_SET_PDEATHSIG, SIGHUP);
        ptrace(PTRACE_TRACEME, 0, 0, 0);
        puts("Give me some shellcode, k");
        gets(input_buffer);
        return 0;
    }

    while (1) {
        wait(&wait_status);

        if ((wait_status & 0x7f) == 0) {
            puts("child is exiting...");
            break;
        }

        if ((((wait_status & 0x7f) + 1) >> 1) > 0) {
            puts("child is exiting...");
            break;
        }

        traced_syscall = ptrace(PTRACE_PEEKUSER, child_pid, 44, 0);
        if (traced_syscall == 11) {
            puts("no exec() for you");
            kill(child_pid, SIGKILL);
            break;
        }
    }

    return 0;
}
