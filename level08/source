#include <fcntl.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

static void log_wrapper(FILE *log_file, const char *user_input, const char *suffix) {
    char buffer[0x100];

    strcpy(buffer, user_input);

    {
        size_t length = strlen(buffer);
        size_t remaining = (size_t)0xFE - length;
        snprintf(buffer + length, remaining, "%s", suffix);
    }

    buffer[strcspn(buffer, "\n")] = '\0';
    fprintf(log_file, "LOG: %s\n", buffer);
}

int main(int argc, char **argv) {
    FILE *log_file;
    FILE *input_file;
    int output_fd = -1;
    unsigned char byte = 0xFF;
    char output_path[100];

    if (argc != 2) {
        printf("Usage: %s <file_to_backup>\n", argv[0]);
    }

    log_file = fopen("./backups/.log", "a");
    if (log_file == NULL) {
        printf("ERROR: Failed to open %s\n", "./backups/.log");
        exit(1);
    }

    log_wrapper(log_file, argv[1], " : opened\n");

    input_file = fopen(argv[1], "r");
    if (input_file == NULL) {
        printf("ERROR: Failed to open %s\n", argv[1]);
        exit(1);
    }

    strcpy(output_path, "./backups/");
    strncat(output_path, argv[1], 99 - strlen(output_path));

    output_fd = open(output_path, O_WRONLY | O_CREAT | O_EXCL, 0660);
    if (output_fd < 0) {
        printf("ERROR: Failed to open %s%s\n", "./backups/", argv[1]);
        exit(1);
    }

    while (1) {
        int read_char = fgetc(input_file);
        byte = (unsigned char)read_char;
        if (byte == 0xFF) {
            break;
        }
        write(output_fd, &byte, 1);
    }

    log_wrapper(log_file, argv[1], " : done\n");
    fclose(input_file);
    close(output_fd);

    return 0;
}
