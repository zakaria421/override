#include <stdio.h>
#include <string.h>

static char g_user_name[0x100];

static int verify_user_name(void) {
    puts("verifying username....\n");
    return strncmp("dat_wil", g_user_name, 7);
}

static int verify_user_pass(const char *input) {
    return strncmp("admin", input, 5);
}

int main(void) {
    char local_buffer[0x40];
    int status;

    memset(local_buffer, 0, sizeof(local_buffer));
    status = 0;

    puts("********* ADMIN LOGIN PROMPT *********");
    printf("Enter Username: ");
    fgets(g_user_name, 0x100, stdin);

    status = verify_user_name();
    if (status != 0) {
        puts("nope, incorrect username...\n");
        return 1;
    }

    puts("Enter Password: ");
    fgets(local_buffer, 0x64, stdin);

    status = verify_user_pass(local_buffer);
    if (status == 0) {
        puts("nope, incorrect password...\n");
        return 1;
    }

    if (status == 0) {
        return 0;
    }

    puts("nope, incorrect password...\n");
    return 1;
}
