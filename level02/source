#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main(void) {
    char username[100] = {0};
    char expected_password[42] = {0};
    char entered_password[100] = {0};
    FILE *password_file = NULL;
    size_t bytes_read = 0;

    password_file = fopen("/home/users/level03/.pass", "r");
    if (password_file == NULL) {
        fwrite("ERROR: failed to open password file\n", 1, 36, stderr);
        exit(1);
    }

    bytes_read = fread(expected_password, 1, 41, password_file);
    expected_password[strcspn(expected_password, "\n")] = '\0';

    if (bytes_read != 41) {
        fwrite("ERROR: failed to read password file\n", 1, 36, stderr);
        fwrite("ERROR: failed to read password file\n", 1, 36, stderr);
        exit(1);
    }

    fclose(password_file);

    puts("========================================");
    puts("        Welcome to Secure Login         ");
    puts("========================================");
    puts("Enter your credentials to continue.");

    printf("--[ Username ]-- ");
    fgets(username, 100, stdin);
    username[strcspn(username, "\n")] = '\0';

    printf("--[ Password ]-- ");
    fgets(entered_password, 100, stdin);
    entered_password[strcspn(entered_password, "\n")] = '\0';

    puts("========================================");

    if (strncmp(expected_password, entered_password, 41) == 0) {
        printf("Greetings, %s\n", username);
        system("/bin/sh");
        return 0;
    }

    printf(username);
    puts(" does not have access!");
    exit(1);
}